 {
  "doctype": "Client Eligibility Criteria",
  "criteria_name": "Claimant is Covered Member",
  "criteria_code": "MEMBER_COVERED",
  "description": "Claimant must exist in policy members, or policy has no member list.",
  "applies_to": "All Schemes",
  "claim_type": "All",
  "status": "Active",
  "evaluation_stage": "Claim Intake",
  "is_system": 1,
  "is_mandatory": 1,
  "weightage": 10,
  "failure_action": "Block Submission",
  "severity": "High",
  "evaluation_method": "Expression",
