 {
  "doctype": "Client Eligibility Criteria",
  "criteria_name": "Incident within Policy Period",
  "criteria_code": "WITHIN_COVERAGE",
  "description": "Incident date must fall between policy start and end dates.",
  "applies_to": "All Schemes",
  "claim_type": "All",
  "status": "Active",
  "evaluation_stage": "Claim Intake",
  "is_system": 1,
  "is_mandatory": 1,
  "weightage": 15,
  "failure_action": "Block Submission",
  "severity": "Critical",
  "evaluation_method": "Expression",
  "python_expression": "policy and claim.incident_date and getdate(policy.start_date) <= getdate(claim.incident_date) <= getdate(policy.end_date)",
  "name": "WITHIN_COVERAGE"
 },
 {
  "doctype": "Client Eligibility Criteria",
  "criteria_name": "Waiting Period Completed",
  "criteria_code": "WAITING_PERIOD",
  "description": "Incident date must be after policy start date plus scheme waiting period.",
  "applies_to": "All Schemes",
  "claim_type": "All",
  "status": "Active",
  "evaluation_stage": "Claim Intake",
  "is_system": 1,
  "is_mandatory": 1,
  "weightage": 10,
  "failure_action": "Block Submission",
  "severity": "High",
  "evaluation_method": "Expression",
  "python_expression": "not scheme or not scheme.waiting_period_days or (policy and claim.incident_date and date_diff(getdate(claim.incident_date), getdate(policy.start_date)) >= cint(scheme.waiting_period_days))",
  "name": "WAITING_PERIOD"
 },
 {
