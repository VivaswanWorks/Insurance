  "claim_type": "All",
  "status": "Active",
  "evaluation_stage": "Claim Intake",
  "is_system": 1,
  "is_mandatory": 1,
  "weightage": 8,
  "failure_action": "Require Override",
  "override_role": "Insurance Manager",
  "severity": "Medium",
  "evaluation_method": "Expression",
  "python_expression": "not claim.incident_date or not (claim.reported_date or claim.submission_date) or date_diff(getdate(claim.reported_date or claim.submission_date), getdate(claim.incident_date)) <= max_intimation_days",
  "name": "INTIMATION_TIMELY"
 },
 {
  "doctype": "Client Eligibility Criteria",
  "criteria_name": "Member Age within Scheme Limits",
  "criteria_code": "AGE_ELIGIBLE",
  "description": "Member age should be within scheme min/max age limits.",
  "applies_to": "All Schemes",
  "claim_type": "All",
  "status": "Active",
  "evaluation_stage": "Both",
  "is_system": 1,
  "is_mandatory": 0,
  "weightage": 5,
  "failure_action": "Warning Only",
  "severity": "Low",
  "evaluation_method": "Expression",
  "python_expression": "not scheme or not client or not client.date_of_birth or ((not scheme.minimum_age or int(date_diff(nowdate(), client.date_of_birth) / 365.25) >= cint(scheme.minimum_age)) and (not scheme.maximum_age or int(date_diff(nowdate(), client.date_of_birth) / 365.25) <= cint(scheme.maximum_age)))",
  "name": "AGE_ELIGIBLE"
 },
 {
  "doctype": "Client Eligibility Criteria",
  "criteria_name": "Incident not under Exclusions",
  "criteria_code": "EXCLUSION_CHECK",
